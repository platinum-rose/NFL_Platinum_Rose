{
  "suite": "contract_ingestion",
  "suite_version": "v0.2",
  "leakage_policy": "held_out_from_development_fixtures",
  "description": "Malformed, stale, duplicate, mixed-shape, and unsupported futures rows for canonicalization, devig, identity, and freshness gates.",
  "case_groups": [
    {
      "id": "wins_legacy_side_rows",
      "count": 14,
      "market": "wins",
      "mutations": ["team_contains_over_under_side", "selection_duplicates_team", "missing_pair_side", "same_team_multiple_lines"],
      "expected": ["merge_to_canonical_team", "no_side_text_in_team", "preserve_source_row_id", "line_specific_side_fields"]
    },
    {
      "id": "playoffs_legacy_yes_no_rows",
      "count": 12,
      "market": "playoffs",
      "mutations": ["team_contains_yes_no_side", "asymmetric_yes_no_prices", "duplicate_book_snapshot", "missing_no_side"],
      "expected": ["merge_yes_no_pair", "devig_binary_pair", "no_side_text_in_team", "thin_pair_flag_when_side_missing"]
    },
    {
      "id": "stale_or_missing_quote_lineage",
      "count": 10,
      "mutations": ["quote_age_above_max", "missing_observed_at", "old_best_price_new_context_price", "mixed_snapshot_window"],
      "expected": ["mark_stale_or_missing", "exclude_from_final_recommendation", "render_quote_age"]
    },
    {
      "id": "exact_position_grouping",
      "count": 10,
      "market": "division_exact_position",
      "mutations": ["one_team_four_positions", "single_book_overround", "position_in_selection_text", "missing_one_position"],
      "expected": ["group_by_team_position_pool", "devig_four_way_position_pool", "flag_incomplete_position_pool"]
    },
    {
      "id": "placeable_book_filtering",
      "count": 8,
      "mutations": ["draftkings_best_overall", "fanduel_best_overall", "bookmaker_second_best", "unplaceable_only_market"],
      "expected": ["exclude_unplaceable_best_price", "select_best_placeable_book", "mark_no_placeable_quote"]
    },
    {
      "id": "market_identity_edges",
      "count": 10,
      "mutations": ["wrong_line_same_team", "wrong_book_same_price", "wrong_side_same_price", "reversed_exacta_team_order"],
      "expected": ["reject_wrong_line", "reject_wrong_book", "reject_wrong_side", "accept_reversed_exacta_only_when_same_two_teams"]
    },
    {
      "id": "unsupported_market_contracts",
      "count": 8,
      "mutations": ["award_market_without_group_overround", "single_book_most_wins", "least_wins_thin_market"],
      "expected": ["label_market_context_not_independent_edge", "do_not_promote_thin_market_as_positive_ev"]
    }
  ]
}

