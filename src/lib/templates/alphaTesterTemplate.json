{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlphaTesterProfile",
  "description": "Standardized schema for onboarding new NFL Dashboard Alpha testers",
  "type": "object",
  "required": [
    "id",
    "name",
    "realName",
    "nickname",
    "profileMode",
    "role",
    "alphaRole",
    "usagePriority",
    "defaultHub",
    "fantasyLeagues",
    "fantasyTeamBindings",
    "allowedFeatures",
    "blockedFeatures"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Unique identifier (e.g. 'amanda_rose', 'patrick_fagan')"
    },
    "name": {
      "type": "string",
      "description": "Full display name with team/persona context"
    },
    "displayLabel": {
      "type": "string",
      "description": "Short label for dropdown selector (e.g., 'Amanda Rose (Olivators / Wailin Raylans)')"
    },
    "realName": {
      "type": "string",
      "description": "Tester's real first and last name"
    },
    "nickname": {
      "type": "string",
      "description": "Primary fantasy team name or handle"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Tester's contact email for alpha communications"
    },
    "description": {
      "type": "string",
      "description": "Tester's primary workflow, betting interests, and dashboard expectations"
    },
    "role": {
      "type": "string",
      "enum": ["tester"]
    },
    "alphaRole": {
      "type": "string",
      "enum": ["tester", "power_tester"]
    },
    "profileMode": {
      "type": "string",
      "enum": ["alpha"]
    },
    "usagePriority": {
      "type": "string",
      "enum": [
        "waiver_and_injuries",
        "dynasty_and_draft",
        "props_and_odds",
        "start_sit_optimizer",
        "multi_league_matrix",
        "general_scouting"
      ],
      "description": "Determines dashboard focus, widget prioritization, and alert filtering"
    },
    "defaultHub": {
      "type": "string",
      "enum": ["dashboard", "official-picks", "intel", "futures", "fantasy", "injuries", "odds", "analytics"],
      "description": "Landing hub when tester logs in"
    },
    "priorityWidgets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Top dashboard widgets customized for this tester"
    },
    "bettingInterests": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Betting/Contest interests (e.g. ['supercontest', 'player_props', 'survivor', 'game_spreads'])"
    },
    "fantasyLeagues": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["the_league", "honey_badgers", "rfi_invitational", "rose_bowl"]
      },
      "minItems": 1
    },
    "fantasyTeamBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["leagueId", "teamId", "teamName"],
        "properties": {
          "leagueId": { "type": "string" },
          "teamId": { "type": "string" },
          "teamName": { "type": "string" }
        }
      }
    },
    "favoriteTeams": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]{2,3}$" }
    },
    "draftSlots": {
      "type": "object",
      "additionalProperties": { "type": ["integer", "null"] }
    },
    "keeperIntentions": {
      "type": "string",
      "enum": ["undeclared", "declared", "locked"]
    },
    "keeperLocks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "hubs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "agents": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "allowedFeatures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockedFeatures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "canUseAI": {
      "type": "boolean",
      "default": false
    },
    "canStoreApiKeys": {
      "type": "boolean",
      "default": false
    },
    "ownerPortfolioAccess": {
      "type": "boolean",
      "default": false
    }
  },
  "example": {
    "id": "amanda_rose",
    "name": "Amanda Rose",
    "displayLabel": "Amanda Rose (Olivators / Wailin Raylans)",
    "realName": "Amanda Rose",
    "nickname": "Olivators",
    "email": "amanda@example.test",
    "description": "Sunday morning lineup setter and waiver wire specialist monitoring injury recovery and competing in SuperContest.",
    "role": "tester",
    "alphaRole": "tester",
    "profileMode": "alpha",
    "usagePriority": "start_sit_optimizer",
    "defaultHub": "dashboard",
    "priorityWidgets": ["start-sit-comparator", "injury-wire", "waiver-targets", "supercontest-card"],
    "bettingInterests": ["supercontest", "player_props"],
    "fantasyLeagues": ["honey_badgers", "the_league", "rose_bowl"],
    "fantasyTeamBindings": [
      { "leagueId": "honey_badgers", "teamId": "1", "teamName": "Olivators" },
      { "leagueId": "the_league", "teamId": "wailin_raylans", "teamName": "Wailin Raylans" },
      { "leagueId": "rose_bowl", "teamId": "7", "teamName": "Jukin Junies" }
    ],
    "favoriteTeams": ["BUF"],
    "draftSlots": { "the_league": 6, "honey_badgers": 7, "rose_bowl": 8 },
    "keeperIntentions": "undeclared",
    "keeperLocks": {
      "honey_badgers": [],
      "the_league": [],
      "rose_bowl": []
    },
    "hubs": ["dashboard", "official-picks", "intel", "futures", "fantasy", "injuries", "odds", "analytics", "bankroll", "mycard", "picks"],
    "agents": [],
    "allowedFeatures": ["dashboard", "official-picks", "intel-hub", "futures-report", "fantasy-packet", "schedule", "injuries", "market-context", "alpha-local-tracking"],
    "blockedFeatures": ["master", "andy", "owner-futures-portfolio", "ai-agent-chat", "api-key-storage"],
    "canUseAI": false,
    "canStoreApiKeys": false,
    "ownerPortfolioAccess": false
  }
}
