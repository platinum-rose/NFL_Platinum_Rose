[Unit]
Description=NFL Dashboard Overnight Pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=andrewlrose
WorkingDirectory=/home/andrewlrose/projects/NFL_Dashboard
EnvironmentFile=/etc/nfl-line-alert.env
ExecStart=/usr/bin/node scripts/overnight.js
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nfl-overnight
