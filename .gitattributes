# Normalize line endings to LF in the repository.
# Prevents CRLF corruption on Windows checkouts (rolldown/vite 8 fails to parse CRLF JS files on Linux).
* text=auto eol=lf

# Explicitly binary — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.wav binary
